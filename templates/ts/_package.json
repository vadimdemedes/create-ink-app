{
	"name": "%NAME%",
	"version": "0.0.0",
	"license": "MIT",
	"bin": "dist/cli.js",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"test": "prettier --check . && xo && ava",
		"pretest": "npm run build"
	},
	"files": ["dist"],
	"dependencies": {
		"ink": "^7.1.1",
		"meow": "^14.1.0",
		"react": "^19.3.0"
	},
	"devDependencies": {
		"@ava/typescript": "^5.0.0",
		"@sindresorhus/tsconfig": "^8.1.0",
		"@types/react": "^19.3.0",
		"@vdemedes/prettier-config": "^2.0.1",
		"ava": "^6.2.0",
		"chalk": "^5.4.1",
		"ink-testing-library": "^4.0.0",
		"prettier": "^3.4.2",
		"typescript": "^5.8.3",
		"xo": "^1.2.3"
	},
	"ava": {
		"typescript": {
			"extensions": ["ts", "tsx"],
			"rewritePaths": {
				"source/": "dist/"
			},
			"compile": false
		}
	},
	"xo": {
		"react": true,
		"prettier": "compat",
		"rules": {
			"react/prop-types": "off",
			"react/react-in-jsx-scope": "off"
		}
	},
	"prettier": "@vdemedes/prettier-config"
}
